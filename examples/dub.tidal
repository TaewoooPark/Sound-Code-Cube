-- Sound Code Cube: saved Codex score
-- Dub / 72 BPM / D dorian
-- Requires TidalCycles, SuperDirt, Dirt-Samples and native/synths.scd.
-- This file starts all eight layers together. The app schedules their entrances.

hush
setcps (72/60/4)

-- kick
d1 $ slow 2 $ s "~!8 bd:5 ~!15 bd:5 ~!7" # gain "0!8 0.91807 0!15 0.927487 0!7" # sustain "0!8 0.208333 0!15 0.208333 0!7" # pan 0.5 # cutoff 1800

-- bass
d2 $ slow 2 $ midinote "~!11 38 ~!6 50 ~!8 38 ~!4" # s "sccbass" # gain "0!11 0.793275 0!6 0.73409 0!8 0.801946 0!4" # sustain "0!11 1.041667 0!6 0.625 0!8 1.041667 0!4" # pan 0.5 # cutoff 480

-- snare
d3 $ slow 2 $ s "~!8 808sd:2 ~!15 808sd:2 ~!5 808sd:2 ~" # gain "0!8 0.689641 0!15 0.702537 0!5 0.490746 0" # sustain "0!8 0.145833 0!15 0.145833 0!5 0.083333 0" # pan 0.52 # cutoff 3400

-- hats
d4 $ slow 2 $ s "~ ~ 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~!3 808hc:2 ~" # gain "0 0 0.543723 0!3 0.58585 0!3 0.525053 0!3 0.573663 0!3 0.540744 0!3 0.592812 0!3 0.518363 0!3 0.563323 0" # sustain "0 0 0.072917 0!3 0.083333 0!3 0.0625 0!3 0.083333 0!3 0.072917 0!3 0.083333 0!3 0.0625 0!3 0.083333 0" # pan 0.39 # cutoff 6900

-- percussion
d5 $ slow 2 $ s "~!3 east:0 ~!11 east:0 ~!3 east:0 ~!5 east:0 ~!6" # gain "0!3 0.570593 0!11 0.528474 0!3 0.578502 0!5 0.482057 0!6" # sustain "0!3 0.104167 0!11 0.09375 0!3 0.104167 0!5 0.083333 0!6" # pan 0.67 # cutoff 2800

-- chords
d6 $ slow 2 $ stack [midinote "~!6 65 ~!7 65 ~!7 65 ~!7 65 ~" # s "sccorgan" # gain "0!6 0.660567 0!7 0.623574 0!7 0.665371 0!7 0.614727 0" # sustain "0!6 0.135417 0!7 0.104167 0!7 0.135417 0!7 0.104167 0", midinote "~!6 69 ~!7 69 ~!7 69 ~!7 69 ~" # s "sccorgan" # gain "0!6 0.648074 0!7 0.611691 0!7 0.650631 0!7 0.602302 0" # sustain "0!6 0.135417 0!7 0.104167 0!7 0.135417 0!7 0.104167 0", midinote "~!6 72 ~!7 72 ~!7 71 ~!7 71 ~" # s "sccorgan" # gain "0!6 0.634814 0!7 0.599072 0!7 0.626441 0!7 0.585601 0" # sustain "0!6 0.135417 0!7 0.104167 0!7 0.135417 0!7 0.104167 0"] # pan 0.42 # cutoff 2400

-- melody
d7 $ slow 2 $ midinote "~ ~ 81 ~ ~ 84 ~ ~ 83 ~!5 86 ~!5 86 ~!5 86 ~!5" # s "sccpluck" # gain "0 0 0.575639 0 0 0.542161 0 0 0.527455 0!5 0.563463 0!5 0.482057 0!5 0.411953 0!5" # sustain "0 0 0.208333 0 0 0.15625 0 0 0.208333 0!5 0.3125 0!5 0.260417 0!5 0.208333 0!5" # pan 0.655 # cutoff 3900

-- texture
d8 $ slow 2 $ midinote "~!4 74 ~!11 81 ~ 76 ~!13" # s "sccpad" # gain "0!4 0.449433 0!11 0.428139 0 0.411953 0!13" # sustain "0!4 2.5 0!11 2.916667 0 2.5 0!13" # pan 0.325 # cutoff 1500

-- Evaluate hush to stop.
