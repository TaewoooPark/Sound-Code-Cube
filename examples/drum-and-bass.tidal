-- Sound Code Cube: saved Codex score
-- Drum and bass / 165 BPM / A minor
-- Requires TidalCycles, SuperDirt, Dirt-Samples and native/synths.scd.
-- This file starts all eight layers together. The app schedules their entrances.

hush
setcps (165/60/4)

-- kick
d1 $ slow 2 $ s "bd:18 ~!9 bd:18 ~!5 bd:18 ~ ~ bd:18 ~!6 bd:18 ~!5" # gain "0.930605 0!9 0.906413 0!5 0.925917 0 0 0.860193 0!6 0.911407 0!5" # sustain "0.090909 0!9 0.090909 0!5 0.090909 0 0 0.090909 0!6 0.090909 0!5" # pan 0.5 # cutoff 9500

-- bass
d2 $ slow 2 $ midinote "~ ~ 45 ~!3 57 ~!4 45 ~!5 45 ~!4 57 ~!4 45 ~!4" # s "sccacid" # gain "0 0 0.775027 0!3 0.739651 0!4 0.783688 0!5 0.766065 0!4 0.744666 0!4 0.779393 0!4" # sustain "0 0 0.136364 0!3 0.227273 0!4 0.363636 0!5 0.090909 0!4 0.227273 0!4 0.363636 0!4" # pan 0.5 # cutoff 1350

-- snare
d3 $ slow 2 $ s "~!4 sn:35 ~ ~ sn:35 ~!3 sn:35 sn:35 ~ ~ sn:35 ~!4 sn:35 ~ ~ sn:35 ~!4 sn:35 ~ sn:35 sn:35" # gain "0!4 0.779182 0 0 0.549539 0!3 0.581067 0.785138 0 0 0.525053 0!4 0.777166 0 0 0.565961 0!4 0.785138 0 0.590518 0.518363" # sustain "0!4 0.090909 0 0 0.036364 0!3 0.036364 0.090909 0 0 0.036364 0!4 0.090909 0 0 0.036364 0!4 0.090909 0 0.036364 0.027273" # pan 0.51 # cutoff 11500

-- hats
d4 $ slow 2 $ s "hh:3!4 ~ hh:3!7 ~ hh:3!7 ~ hh:3!7 ~ hh:3!3" # gain "0.582337 0.512522 0.635692 0.54011 0 0.528812 0.626543 0.547266 0.590882 0.508196 0.640122 0.532659 0 0.51674 0.628868 0.557499 0.588075 0.520858 0.637918 0.536423 0 0.512522 0.631167 0.55074 0.59365 0.503757 0.644462 0.543723 0 0.520858 0.621814 0.564021" # sustain "0.036364 0.027273 0.045455 0.027273 0 0.027273 0.045455 0.027273 0.036364 0.027273 0.045455 0.027273 0 0.027273 0.045455 0.027273 0.036364 0.027273 0.045455 0.027273 0 0.027273 0.045455 0.027273 0.036364 0.027273 0.045455 0.027273 0 0.027273 0.036364 0.027273" # pan 0.615 # cutoff 14000

-- percussion
d5 $ slow 2 $ s "~!3 perc:4 ~!5 perc:4 ~!4 perc:4 ~!3 perc:4 ~!6 perc:4 ~!3 perc:4 ~ ~" # gain "0!3 0.547875 0!5 0.507433 0!4 0.565132 0!3 0.516921 0!6 0.550441 0!3 0.500798 0 0" # sustain "0!3 0.054545 0!5 0.045455 0!4 0.063636 0!3 0.045455 0!6 0.054545 0!3 0.045455 0 0" # pan 0.34 # cutoff 4800

-- chords
d6 $ slow 2 $ stack [midinote "69 ~!15 69 ~!15" # s "sccpad" # gain "0.581067 0!15 0.578502 0!15" # sustain "1.272727 0!15 1.272727 0!15", midinote "71 ~!15 74 ~!15" # s "sccpad" # gain "0.541533 0!15 0.547723 0!15" # sustain "1.272727 0!15 1.272727 0!15", midinote "76 ~!15 76 ~!15" # s "sccpad" # gain "0.562341 0!15 0.559508 0!15" # sustain "1.272727 0!15 1.272727 0!15", midinote "79 ~!15 79 ~!15" # s "sccpad" # gain "0.547723 0!15 0.538356 0!15" # sustain "1.272727 0!15 1.272727 0!15"] # pan 0.41 # cutoff 3400

-- melody
d7 $ slow 2 $ midinote "~ ~ 81 ~ ~ 84 ~ ~ 83 ~!5 81 ~!3 81 ~ ~ 88 ~ ~ 83 ~!5 81 ~" # s "sccbell" # gain "0 0 0.595789 0 0 0.558363 0 0 0.568428 0!5 0.536423 0!3 0.589301 0 0 0.550441 0 0 0.563463 0!5 0.530495 0" # sustain "0 0 0.136364 0 0 0.090909 0 0 0.181818 0!5 0.136364 0!3 0.136364 0 0 0.090909 0 0 0.181818 0!5 0.136364 0" # pan 0.655 # cutoff 6500

-- texture
d8 $ slow 2 $ midinote "~ 81 ~!13 88 ~!9 83 ~!6" # s "scctexture" # gain "0 0.473814 0!13 0.452702 0!9 0.431912 0!6" # sustain "0 1.090909 0!13 0.818182 0!9 0.545455 0!6" # pan 0.285 # cutoff 4100

